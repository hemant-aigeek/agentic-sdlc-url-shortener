# Copy to .env for local overrides. All variables are optional; see src/agentic_sdlc/config.py.
AGENTIC_DATABASE_URL=sqlite+pysqlite:///data/agentic.db
AGENTIC_API_KEY=dev-key
AGENTIC_BASE_URL=http://127.0.0.1:8000
AGENTIC_LOG_LEVEL=INFO
AGENTIC_LOG_JSON=true

# Orchestration defaults (AS-01)
AGENTIC_RETRY_MAX_ATTEMPTS=3
AGENTIC_RETRY_BASE_DELAY_S=0.1
AGENTIC_STAGE_TIMEOUT_S=5
# AGENTIC_GATE_TIMEOUT_S=   # unset = wait for a human indefinitely

# Demonstration faults (off by default)
AGENTIC_DEMO_FAULT_VERIFY_TRANSIENT_FAILURES=0
AGENTIC_DEMO_FAULT_SECURITY_PERMANENT_FAILURE=false
# AGENTIC_DEMO_FAULT_POLICY_FAIL=SEC-001
